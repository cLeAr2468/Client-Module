# Environment Variables
# This file is for local development

# API Server Configuration
# ========================
# Leave empty to use Server Switcher (recommended)
# Or set to force a specific server:
#
# For LOCAL development:
# VITE_API_URL=http://127.0.0.1:8000/api
#
# For PRODUCTION testing:
# VITE_API_URL=https://logs-server-system-production.up.railway.app/api
#
# Note: Server Switcher allows easy switching between servers via UI
# If VITE_API_URL is set, it overrides the switcher

VITE_API_URL=
